{
	"extends": "@projection/config/tsconfig.base.json",
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"composite": true,
		// tsc follows workspace source imports into @projection/tasks →
		// @projection/templates, which contain .tsx email templates — jsx must
		// stay enabled even though the api package itself has no tsx files.
		"jsx": "react-jsx"
	}
}
