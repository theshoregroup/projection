{
	"name": "@projection/auth",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/auth.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"cli": "SKIP_SERVER_ENV_VALIDATION=1 DUMMY_ENV=1 pnpx auth@1.7.0-rc.2",
		"generate": "pnpm cli generate --output ../../packages/db/src/schema/auth.ts",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.2",
		"@projection/db": "workspace:*",
		"@projection/env": "workspace:*",
		"@projection/tasks": "workspace:*",
		"@theshoregroup/settings-better-auth-plugin": "^0.2.1",
		"@theshoregroup/settings-core": "0.1.2",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@projection/config": "workspace:*",
		"typescript": "catalog:"
	}
}
