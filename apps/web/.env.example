# Auth (better-auth) — see docs/adr/0004-auth-shape.md
BETTER_AUTH_SECRET= # generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Microsoft Entra single-tenant app registration
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Comma-separated emails granted the admin role at first sign-in
ADMIN_EMAILS=you@yourco.com

# PlanetScale Postgres — see docs/adr/0003-planetscale-postgres-drizzle.md
DATABASE_URL=postgres://

# Resend — invite emails, sent via trigger.dev (docs/adr/0005-trigger-dev-background-work.md)
RESEND_API_KEY=re_

# trigger.dev — needed to actually send email / run background tasks
TRIGGER_PROJECT_ID=
TRIGGER_SECRET_KEY=
